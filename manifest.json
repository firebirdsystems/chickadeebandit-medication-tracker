{
  "id": "medication-tracker",
  "name": "Medications",
  "version": "1.0.0",
  "description": "Track daily medications for every family member. Check off doses as they're taken; adults can see the whole household's schedules, children see only their own.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "health",
  "tags": ["health", "medication", "kids", "daily"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "row_policies": {
    "medications": {
      "kind": "adult_writable",
      "member_read_column": "member_id",
      "steward_writes_only": true
    },
    "doses": {
      "kind": "owner_only",
      "member_column": "logged_by",
      "adults_bypass": true
    }
  },
  "nav": { "label": "Medications" },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "💊",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["medications_summary", "todays_doses"]
  }
}
