{
  "id": "medication-tracker",
  "name": "Medications",
  "version": "1.0.0",
  "description": "Track daily medications for every family member. Check off doses as they're taken, get a nudge at each scheduled time, and let a family member know when a dose is missed.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "health",
  "tags": ["health", "medication", "kids", "daily", "reminders"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "required_capabilities": ["cron"],
  "db_plaintext_columns": [
    "slot",
    "reminder_times",
    "days_mask",
    "started_on",
    "ends_on",
    "remind_member_ids",
    "buddy_member_ids"
  ],
  "row_policies": {
    "medications": {
      "kind": "adult_writable",
      "member_read_column": "member_id",
      "steward_writes_only": true
    },
    "doses": {
      "kind": "owner_only",
      "member_column": "logged_by",
      "adults_bypass": true
    }
  },
  "schedule_reminders": {
    "table": "medications",
    "id_column": "id",
    "title_column": "name",
    "owner_column": "member_id",
    "enabled_column": "reminders_on",
    "subtitle_column": "dosage",
    "times_column": "reminder_times",
    "days_of_week_column": "days_mask",
    "interval_days_column": "every_n_days",
    "start_date_column": "started_on",
    "end_date_column": "ends_on",
    "completion": {
      "table": "doses",
      "parent_fk_column": "medication_id",
      "date_column": "dose_date",
      "slot_column": "slot",
      "member_column": "logged_by"
    },
    "nudge": {
      "at_minutes": 0,
      "audience": "owner",
      "member_column": "remind_member_ids"
    },
    "escalation": {
      "grace_minutes": 30,
      "audience": "adults",
      "member_column": "buddy_member_ids"
    }
  },
  "nav": { "label": "Medications" },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "💊",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["medications_summary", "todays_doses"]
  }
}
